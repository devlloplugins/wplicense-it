<?xml version="1.0"?>
<ruleset name="WPLicense It client SDK">
	<description>Coding standards for the client SDK, which sellers embed in plugins that may still run on PHP 7.4.</description>

	<file>sdk</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<!-- The SDK ships inside other people's plugins, so it is namespaced rather than prefixed. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
