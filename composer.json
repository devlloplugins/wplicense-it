{
    "name": "devlloplugins/wplicense-it",
    "description": "Sell and manage license keys for WordPress plugins and themes.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^11.2",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Devllo\\WPLicenseIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devllo\\WPLicenseIt\\Tests\\": "tests/",
            "WPLicenseIt\\Client\\": "sdk/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "phpcs",
            "phpcs --standard=sdk/phpcs.xml.dist"
        ],
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "phpunit"
    }
}
